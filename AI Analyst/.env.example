# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Redis Configuration
REDIS_URL=redis://localhost:6379

# PostgreSQL Configuration
POSTGRES_URL=postgresql://analyst:analyst@localhost:5432/analytics

# Pinecone Vector Database (Optional)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=ai-analyst-schemas

# Server Configuration
PORT=3000
NODE_ENV=development

# Security Configuration
ALLOWED_ORIGIN=http://localhost:3000

# Feature Flags
FLAG_USE_PINECONE=false
FLAG_ENABLE_COST_ESTIMATOR=true
FLAG_ENABLE_FEEDBACK_LOGGING=true
FLAG_ENABLE_RISK_SCORING=true
FLAG_ENABLE_QUERY_CACHE=true
FLAG_ENABLE_ADVANCED_RETRIEVAL=false

# Observability
ENABLE_TRACING=true
TRACE_EXPORT_URL=http://localhost:4318/v1/traces