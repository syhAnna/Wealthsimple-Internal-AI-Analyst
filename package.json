{
  "name": "wealthsimple-ai-analyst",
  "version": "2.0.0",
  "description": "Production-ready AI analytics platform with RBAC, caching, and cost estimation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "eval": "ts-node src/eval/runEval.ts",
    "eval:compare": "ts-node src/eval/runEval.ts gpt-4o-mini gpt-4o",
    "load-test": "k6 run load-test.js",
    "docker:build": "docker build -t ai-analyst:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "k8s:apply": "kubectl apply -f k8s/",
    "k8s:delete": "kubectl delete -f k8s/",
    "k8s:logs": "kubectl logs -n ai-analyst -l app=ai-analyst -f"
  },
  "keywords": [
    "ai",
    "analytics",
    "fintech",
    "governance",
    "sql",
    "rbac",
    "redis",
    "production"
  ],
  "author": "Wealthsimple",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/sdk-trace-base": "^1.21.0",
    "@opentelemetry/sdk-trace-node": "^1.21.0",
    "@pinecone-database/pinecone": "^7.1.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "openai": "^4.28.0",
    "pg": "^8.18.0",
    "redis": "^4.6.13",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.19",
    "@types/pg": "^8.16.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
